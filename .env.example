POSTGRES_DB=tracksea
POSTGRES_USER=tracksea
POSTGRES_PASSWORD=tracksea_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://tracksea:tracksea_dev_password@localhost:5432/tracksea

BACKEND_PORT=8000
FRONTEND_PORT=5173

SESSION_LIFETIME_SECONDS=2592000
SESSION_LAST_SEEN_INTERVAL_SECONDS=300
# Local plain HTTP only. Non-local environments require Secure cookies.
SESSION_COOKIE_NAME=tracksea_session
SESSION_COOKIE_SECURE=false

FRONTEND_ORIGIN=http://localhost:5173
# Development placeholder only. Generate a replacement from backend/ with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET=development-only-change-this-csrf-secret
CSRF_COOKIE_NAME=tracksea_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TOKEN_TTL_SECONDS=3600

# Development placeholder only. Generate a separate replacement from backend/:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_THROTTLE_SECRET=development-only-change-this-auth-throttle-secret
AUTH_ACCOUNT_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=20
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_BLOCK_SECONDS=900

# Optional: leave empty to disable Google authentication. Use the same Google
# OAuth Web client ID for both values during local real-Google testing. A client
# ID is browser-visible public configuration; no Google client secret is used.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
